# Production Postgres (Neon, RDS, etc.). Leave unset for local PGLite.
DATABASE_URL=

# Better Auth secret — generate a long random string for production.
BETTER_AUTH_SECRET=

# Public origin of the deployed app, e.g. https://stella.example.com
BETTER_AUTH_URL=

# Optional OAuth. Email/password sign-in works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
