# Production Postgres (Neon, RDS, Docker, etc.). Leave unset for local PGLite.
DATABASE_URL=

# Docker Compose default (uncomment / copy into a local `.env`):
# DATABASE_URL=postgres://stella:stella@db:5432/stella

# Better Auth secret — generate a long random string for production.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public origin of the deployed app, e.g. https://stella.example.com
# Docker Compose default: http://localhost:3000
BETTER_AUTH_URL=

# Optional OAuth. Email/password sign-in works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
